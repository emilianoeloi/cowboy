# ----------------------------
calculadora
*.exe
*.o
*.so
*.dylib

# Arquivos intermediários do GnuCOBOL
*.c
*.lst
*.cob.c

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ----------------------------
# Editores e IDEs
# ----------------------------
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# ----------------------------
# Logs e temporários
# ----------------------------
*.log
*.tmp
*.bak
core
core.*

# ----------------------------
# Harness (estado de fase local)
# ----------------------------
.harness/

### Harness — estado local de fase (não commitar)
.harness/
*/skills/architecture-*
*/skills/harness*
*/skills/install*
*/skills/dev*
!harness.config.json
!docs/HARNESS_QUADRANTE.md

### Python (Scripts/*.py, Scripts/hooks/, Scripts/harness/)
__pycache__/
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

### OpenSpec
*openspec/
openspec
*openspec*
*opsx/
*opsx-*
!/.github/skills/**

### OpenSPDD
spdd/
*spdd*
!/.github/skills/**

### VSCode
.vscode/